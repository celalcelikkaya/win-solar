<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WinSolar</AssemblyName>
    <RootNamespace>WinSolar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\build\icon.ico</ApplicationIcon>
    <Description>Switches Windows between light and dark with the sun.</Description>
    <!-- Becomes the exe's FileDescription, which Windows shows as the app name in Task Manager and some lists. -->
    <AssemblyTitle>Win Solar</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF needs PerMonitorV2 in the manifest; the WinForms analyzer (pulled in for the tray icon) objects to that. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, ContextMenu, etc.: keep WinForms/Drawing out of implicit usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Win Solar mark, shown in the About row and the tray menu (same file as the exe icon). -->
    <Resource Include="..\..\build\icon.ico" Link="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.17.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinSolar.Core\WinSolar.Core.csproj" />
  </ItemGroup>

</Project>
